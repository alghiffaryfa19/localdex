<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/viewerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:text="Starting…" />

    <!-- Software cursor overlay: always visible regardless of display routing -->
    <ImageView
        android:id="@+id/cursorView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:src="@drawable/ic_cursor"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:elevation="10dp" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.5"
        android:background="@drawable/close_button_bg"
        android:contentDescription="Stop DeX"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</FrameLayout>
